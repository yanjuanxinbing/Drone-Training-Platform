# ============================================================================
# Drone Training Platform — backend ignore rules
#
# Self-contained: every Python / FastAPI / ProjectAirSim pattern the backend
# needs to stay clean lives here, so this directory works correctly even
# after a future cleanup of the root .gitignore.
#
# The root .gitignore also contains equivalent rules (currently duplicated
# for safety) so a fresh checkout stays clean either way.
# ============================================================================

# ----- Python bytecache & compiled artifacts -----
__pycache__/
*.py[cod]
*$py.class
*.so
*.pyo

# ----- Distribution / packaging -----
*.egg-info/
*.egg
build/
dist/
*.whl
*.spec

# ----- Virtual environments -----
.venv/
venv/
env/
ENV/
.python-version

# ----- Testing, type-checking & linting caches -----
.pytest_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
.mypy_cache/
.ruff_cache/
.pyright/

# ----- Uvicorn / FastAPI -----
.uvicorn/
uvicorn.log

# ----- Local databases -----
*.db
*.sqlite3
*.sqlite
instance/

# ----- ProjectAirSim / UE5 simulation artifacts -----
*.ue4save
*.pak
Saved/
Intermediate/
Build/
Binaries/
DerivedDataCache/
*.recording
recordings/
captures/

# ----- Map / geo caches (folium, geopy) -----
folium_cache/

# ----- Logs (mirrored at root for self-containment) -----
*.log
logs/
log/

# ----- Jupyter -----
.ipynb_checkpoints/

# ----- Cross-project runtime data mounted by FastAPI (/media etc.) -----
# /db/img and /db/data are runtime-mounts under the backend, not source.
/db/img
/db/data

# ----- Tooling caches that may surface inside /backend -----
.cache/
.turbo/
